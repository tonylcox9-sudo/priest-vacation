generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  email         String   @unique
  password      String
  phone         String?
  emailVerified DateTime?
  
  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  
  vacationRequests VacationRequest[]
  
  @@map("users")
}

model Admin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("diocese_admin")
  
  @@map("admins")
}

model VacationRequest {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Link to user
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  
  // Priest info
  priestName         String
  priestParish       String
  priestDiocese      String
  
  // Vacation details
  preferredStartDate DateTime?
  duration           String
  destinationType    String
  specialNotes       String?
  
  // Diocese workflow
  status             String   @default("pending")
  // pending, under_review, payment_required, payment_pending, payment_verified, approved, denied
  
  estimatedCost      Decimal? @db.Decimal(10, 2)
  dioceseNotes       String?
  
  // Payment
  bankName           String?
  accountNumber      String?
  accountName        String?
  
  // Receipt upload
  receiptUrl         String?
  receiptUploadedAt  DateTime?
  
  // Tracking
  reviewedAt         DateTime?
  reviewedBy         String?
  paymentVerifiedAt  DateTime?
  paymentVerifiedBy  String?
  
  @@map("vacation_requests")
}